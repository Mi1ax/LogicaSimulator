{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logica Simulator",
  "version": "1.2.2",
  "identifier": "com.logica.simulator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Logica Simulator — Native Hybrid (Tauri + Rust)",
        "width": 1440,
        "height": 900,
        "minWidth": 480,
        "minHeight": 360,
        "resizable": true,
        "backgroundColor": "#0f172a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
